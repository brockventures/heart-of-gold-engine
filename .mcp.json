{
  "mcpServers": {
    "karakos-admin": {
      "command": "python3",
      "args": ["mcp/admin-server.py"],
      "env": {}
    },
    "system-tools": {
      "command": "python3",
      "args": ["mcp/tools-server.py"],
      "env": {}
    },
    "browser": {
      "command": "node",
      "args": ["mcp/browser/node_modules/@playwright/mcp/cli.js", "--headless", "--browser", "chromium"],
      "env": {}
    }
  }
}
