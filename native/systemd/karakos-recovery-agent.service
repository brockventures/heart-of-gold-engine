[Unit]
Description=Karakos recovery-agent (deterministic ops watchdog, non-LLM)
After=network-online.target karakos-agent-server.service
Wants=network-online.target

[Service]
Type=simple
User=karakos
Group=karakos

WorkingDirectory=/opt/karakos
Environment=HOME=/home/karakos
Environment=WORKSPACE_ROOT=/opt/karakos
EnvironmentFile=/opt/karakos/config/.env

ExecStart=/opt/karakos/.venv/bin/python3 /opt/karakos/bin/recovery-agent.py

Restart=always
RestartSec=2
RestartSteps=8
RestartMaxDelaySec=300

# Matches supervisord.conf's stopwaitsecs=15 for [program:recovery-agent].
TimeoutStopSec=15
KillSignal=SIGTERM

# Persistent logging already added 2026-08-10 (logs/recovery-agent.log) —
# this unit's journal output is a second, redundant view of the same
# lifecycle events, not a replacement for that file.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=karakos-recovery-agent

[Install]
WantedBy=multi-user.target
